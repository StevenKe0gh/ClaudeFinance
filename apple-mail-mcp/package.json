{
  "name": "apple-mail-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude read, organize and draft email in the macOS Mail app",
  "type": "module",
  "bin": {
    "apple-mail-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/jxa && cp src/jxa/*.js dist/jxa/",
    "start": "node dist/index.js",
    "check": "node dist/index.js --check",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
